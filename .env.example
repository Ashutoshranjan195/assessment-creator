# =============================================================================
# Root level example env. Copy individual app-level .env.example files as well.
# =============================================================================

# --- LLM provider --------------------------------------------------------------
# TODO: USER MUST PROVIDE — choose provider and supply API key.
# Supported providers (see apps/worker/src/llm.ts): "openai" | "anthropic" | "mock"
LLM_PROVIDER=mock
# TODO: USER MUST PROVIDE — leave empty if LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- MongoDB -------------------------------------------------------------------
# TODO: USER MUST PROVIDE production URI (e.g. MongoDB Atlas)
MONGODB_URI=mongodb://mongo:27017/vedaai

# --- Redis ---------------------------------------------------------------------
# TODO: USER MUST PROVIDE production URL (e.g. Upstash, Redis Cloud)
REDIS_URL=redis://redis:6379

# --- Backend / Worker ----------------------------------------------------------
BACKEND_PORT=4000
BACKEND_URL=http://backend:4000
FRONTEND_URL=http://frontend:3000
PUBLIC_BACKEND_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Storage for generated PDFs (dev = local disk). For prod set S3 vars below.
PDF_STORAGE_DIR=./storage/pdfs

# --- Optional cloud storage (prod) --------------------------------------------
# TODO: USER MUST PROVIDE if using S3-compatible storage in production.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Frontend ------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- Security ------------------------------------------------------------------
# TODO: USER MUST PROVIDE a long random string for signed cookies / JWT (if enabled later)
APP_SECRET=replace-with-long-random-string
